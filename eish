//@version=6
indicator("BREAKOUTBULL SYSTEM V3 - DOUBLE REVERSAL", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=20)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SETTINGS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

string TZ = "Africa/Johannesburg"

groupDaily = "Daily Highs & Lows"
showToday = input.bool(true, "Show today's boxes", group=groupDaily)
showYesterday = input.bool(true, "Show yesterday's boxes", group=groupDaily)
showTwoDaysAgo = input.bool(true, "Show two-days-ago boxes", group=groupDaily)
zoneSize = input.float(1.0, "Grey box thickness", minval=0.1, step=0.1, group=groupDaily)

groupReversal = "Double Reversal Settings"
pivotLen = input.int(3, "M1 swing confirmation bars", minval=1, group=groupReversal)
h1PivotLen = input.int(2, "H1 double top/bottom pivot bars", minval=1, group=groupReversal)
doubleTolerance = input.float(2.0, "Maximum distance between H1 tests", minval=0.1, step=0.1, group=groupReversal)
minDoubleBars = input.int(2, "Minimum H1 bars between tests", minval=1, group=groupReversal)
maxDoubleBars = input.int(12, "Maximum H1 bars between tests", minval=2, group=groupReversal)
bosBuffer = input.float(0.0, "M1 BOS buffer", minval=0, step=0.1, group=groupReversal)
retestBuffer = input.float(0.5, "M1 retest distance", minval=0.1, step=0.1, group=groupReversal)

groupContinuation = "Continuation Settings"
fibLevel = input.float(78.6, "Retracement percentage", minval=1, maxval=99, step=0.1, group=groupContinuation)
continuationBuffer = input.float(0.5, "Fib touch distance", minval=0.1, step=0.1, group=groupContinuation)

groupDuplicate = "Signal Protection"
duplicateDistance = input.float(3.0, "Minimum distance between same-direction signals", minval=0, step=0.1, group=groupDuplicate)
duplicateBars = input.int(10, "Minimum bars between same-direction signals", minval=1, group=groupDuplicate)

groupPsych = "Psychological Levels"
showPsych = input.bool(true, "Show psychological levels", group=groupPsych)
psychStep = input.float(25.0, "Psychological level interval", minval=1, step=1, group=groupPsych)
psychRange = input.int(10, "Levels above/below price", minval=1, maxval=50, group=groupPsych)

groupVisual = "Visual Settings"
showMidnight = input.bool(true, "Show SAST midnight separator", group=groupVisual)

groupDebug = "Diagnostic Settings"
showDiagnostics = input.bool(true, "Show diagnostic markers", group=groupDebug)
showBlockedLabels = input.bool(true, "Show blocked signal labels", group=groupDebug)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SAST DAILY TRACKING
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

int dayKey = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
bool newSastDay = ta.change(dayKey) != 0

var int activeDayKey = na
var float todayHigh = na
var float todayLow = na
var float yesterdayHigh = na
var float yesterdayLow = na
var float twoDaysHigh = na
var float twoDaysLow = na

if na(activeDayKey)
    activeDayKey := dayKey
    todayHigh := high
    todayLow := low
else if newSastDay
    twoDaysHigh := yesterdayHigh
    twoDaysLow := yesterdayLow
    yesterdayHigh := todayHigh
    yesterdayLow := todayLow
    todayHigh := high
    todayLow := low
    activeDayKey := dayKey
else
    todayHigh := math.max(nz(todayHigh, high), high)
    todayLow := math.min(nz(todayLow, low), low)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MIDNIGHT SEPARATOR
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if showMidnight and newSastDay
    line.new(bar_index, low, bar_index, high, extend=extend.both, color=color.maroon, width=1)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DAILY HIGH AND LOW GREY BOXES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var box todayHighBox = na
var box todayLowBox = na
var box yesterdayHighBox = na
var box yesterdayLowBox = na
var box twoDaysHighBox = na
var box twoDaysLowBox = na

if barstate.isfirst or newSastDay
    if not na(todayHighBox)
        box.delete(todayHighBox)
    if not na(todayLowBox)
        box.delete(todayLowBox)
    if not na(yesterdayHighBox)
        box.delete(yesterdayHighBox)
    if not na(yesterdayLowBox)
        box.delete(yesterdayLowBox)
    if not na(twoDaysHighBox)
        box.delete(twoDaysHighBox)
    if not na(twoDaysLowBox)
        box.delete(twoDaysLowBox)

    todayHighBox := na
    todayLowBox := na
    yesterdayHighBox := na
    yesterdayLowBox := na
    twoDaysHighBox := na
    twoDaysLowBox := na

    if showToday and not na(todayHigh)
        todayHighBox := box.new(bar_index, todayHigh + zoneSize, bar_index + 1, todayHigh - zoneSize, extend=extend.right, bgcolor=color.new(color.gray, 82), border_color=color.new(color.gray, 100))

    if showToday and not na(todayLow)
        todayLowBox := box.new(bar_index, todayLow + zoneSize, bar_index + 1, todayLow - zoneSize, extend=extend.right, bgcolor=color.new(color.gray, 82), border_color=color.new(color.gray, 100))

    if showYesterday and not na(yesterdayHigh)
        yesterdayHighBox := box.new(bar_index, yesterdayHigh + zoneSize, bar_index + 1, yesterdayHigh - zoneSize, extend=extend.right, bgcolor=color.new(color.gray, 82), border_color=color.new(color.gray, 100))

    if showYesterday and not na(yesterdayLow)
        yesterdayLowBox := box.new(bar_index, yesterdayLow + zoneSize, bar_index + 1, yesterdayLow - zoneSize, extend=extend.right, bgcolor=color.new(color.gray, 82), border_color=color.new(color.gray, 100))

    if showTwoDaysAgo and not na(twoDaysHigh)
        twoDaysHighBox := box.new(bar_index, twoDaysHigh + zoneSize, bar_index + 1, twoDaysHigh - zoneSize, extend=extend.right, bgcolor=color.new(color.gray, 82), border_color=color.new(color.gray, 100))

    if showTwoDaysAgo and not na(twoDaysLow)
        twoDaysLowBox := box.new(bar_index, twoDaysLow + zoneSize, bar_index + 1, twoDaysLow - zoneSize, extend=extend.right, bgcolor=color.new(color.gray, 82), border_color=color.new(color.gray, 100))

if not na(todayHighBox)
    box.set_top(todayHighBox, todayHigh + zoneSize)
    box.set_bottom(todayHighBox, todayHigh - zoneSize)

if not na(todayLowBox)
    box.set_top(todayLowBox, todayLow + zoneSize)
    box.set_bottom(todayLowBox, todayLow - zoneSize)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PSYCHOLOGICAL LEVELS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var line[] psychLines = array.new_line()

if barstate.islast
    if array.size(psychLines) > 0
        for i = 0 to array.size(psychLines) - 1
            line.delete(array.get(psychLines, i))
        array.clear(psychLines)

    if showPsych
        float baseLevel = math.round(close / psychStep) * psychStep

        for i = -psychRange to psychRange
            float level = baseLevel + i * psychStep
            bool is100 = math.abs(level / 100.0 - math.round(level / 100.0)) < 0.000001
            bool is50 = math.abs(level / 50.0 - math.round(level / 50.0)) < 0.000001
            color levelColor = is100 ? color.black : is50 ? color.red : color.lime
            int levelWidth = is100 ? 2 : is50 ? 2 : 1

            line newLine = line.new(bar_index - 100, level, bar_index + 5, level, extend=extend.right, color=levelColor, width=levelWidth)
            array.push(psychLines, newLine)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ALL-BLACK CANDLES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

barcolor(color.black)

plotcandle(
     open,
     high,
     low,
     close,
     title="BREAKOUTBULL BLACK CANDLES",
     color=color.black,
     wickcolor=color.black,
     bordercolor=color.black
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CONFIRMED HOURLY DATA
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[h1Open, h1High, h1Low, h1Close, h1PreviousClose, h1PivotHigh, h1PivotLow] = request.security(
     syminfo.tickerid,
     "60",
     [open[1], high[1], low[1], close[1], close[2], ta.pivothigh(high, h1PivotLen, h1PivotLen)[1], ta.pivotlow(low, h1PivotLen, h1PivotLen)[1]],
     lookahead=barmerge.lookahead_on
)

bool newH1Bar = ta.change(time("60")) != 0
var int h1Sequence = 0

if newH1Bar
    h1Sequence += 1

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// H1 DOUBLE TOP / DOUBLE BOTTOM TRACKING
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var float firstTopPrice = na
var int firstTopSequence = na
var float firstBottomPrice = na
var int firstBottomSequence = na

var bool doubleTopPending = false
var bool doubleBottomPending = false
var bool reversalBuyArmed = false
var bool reversalSellArmed = false

var float buyBOSLevel = na
var float sellBOSLevel = na
var int buyBOSBar = na
var int sellBOSBar = na

bool doubleTopDetected = false
bool doubleBottomDetected = false
bool h1SellConfirmed = false
bool h1BuyConfirmed = false

if newSastDay
    firstTopPrice := na
    firstTopSequence := na
    firstBottomPrice := na
    firstBottomSequence := na
    doubleTopPending := false
    doubleBottomPending := false
    reversalBuyArmed := false
    reversalSellArmed := false
    buyBOSLevel := na
    sellBOSLevel := na
    buyBOSBar := na
    sellBOSBar := na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DETECT TWO H1 TESTS AT YESTERDAY'S HIGH
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if newH1Bar and not na(h1PivotHigh) and not na(yesterdayHigh)
    bool topInsideZone = math.abs(h1PivotHigh - yesterdayHigh) <= zoneSize

    if topInsideZone
        if na(firstTopPrice)
            firstTopPrice := h1PivotHigh
            firstTopSequence := h1Sequence
        else
            int topGap = h1Sequence - firstTopSequence
            bool correctSeparation = topGap >= minDoubleBars and topGap <= maxDoubleBars
            bool similarPrices = math.abs(h1PivotHigh - firstTopPrice) <= doubleTolerance

            if correctSeparation and similarPrices
                doubleTopPending := true
                doubleTopDetected := true
                firstTopPrice := na
                firstTopSequence := na
            else
                firstTopPrice := h1PivotHigh
                firstTopSequence := h1Sequence

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DETECT TWO H1 TESTS AT YESTERDAY'S LOW
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if newH1Bar and not na(h1PivotLow) and not na(yesterdayLow)
    bool bottomInsideZone = math.abs(h1PivotLow - yesterdayLow) <= zoneSize

    if bottomInsideZone
        if na(firstBottomPrice)
            firstBottomPrice := h1PivotLow
            firstBottomSequence := h1Sequence
        else
            int bottomGap = h1Sequence - firstBottomSequence
            bool correctSeparation = bottomGap >= minDoubleBars and bottomGap <= maxDoubleBars
            bool similarPrices = math.abs(h1PivotLow - firstBottomPrice) <= doubleTolerance

            if correctSeparation and similarPrices
                doubleBottomPending := true
                doubleBottomDetected := true
                firstBottomPrice := na
                firstBottomSequence := na
            else
                firstBottomPrice := h1PivotLow
                firstBottomSequence := h1Sequence

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// H1 CLOSE CONFIRMATION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if newH1Bar and doubleTopPending and not na(yesterdayHigh)
    if h1Close > yesterdayHigh
        doubleTopPending := false
    else if h1Close < yesterdayHigh
        reversalSellArmed := true
        sellBOSLevel := na
        sellBOSBar := na
        h1SellConfirmed := true
        doubleTopPending := false

if newH1Bar and doubleBottomPending and not na(yesterdayLow)
    if h1Close < yesterdayLow
        doubleBottomPending := false
    else if h1Close > yesterdayLow
        reversalBuyArmed := true
        buyBOSLevel := na
        buyBOSBar := na
        h1BuyConfirmed := true
        doubleBottomPending := false

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// M1 CONFIRMED STRUCTURE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

float pivotHigh = ta.pivothigh(high, pivotLen, pivotLen)
float pivotLow = ta.pivotlow(low, pivotLen, pivotLen)

var float lastPivotHigh = na
var float lastPivotLow = na

if not na(pivotHigh)
    lastPivotHigh := pivotHigh

if not na(pivotLow)
    lastPivotLow := pivotLow

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// M1 BREAK OF STRUCTURE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bool bullishBOS = reversalBuyArmed and not na(lastPivotHigh) and close > lastPivotHigh + bosBuffer and close[1] <= lastPivotHigh + bosBuffer
bool bearishBOS = reversalSellArmed and not na(lastPivotLow) and close < lastPivotLow - bosBuffer and close[1] >= lastPivotLow - bosBuffer

if barstate.isconfirmed and bullishBOS
    buyBOSLevel := lastPivotHigh
    buyBOSBar := bar_index

if barstate.isconfirmed and bearishBOS
    sellBOSLevel := lastPivotLow
    sellBOSBar := bar_index

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// M1 RETEST CONFIRMATION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bool reversalBuy =
     reversalBuyArmed and
     not na(buyBOSLevel) and
     not na(buyBOSBar) and
     bar_index > buyBOSBar and
     low <= buyBOSLevel + retestBuffer and
     close > buyBOSLevel and
     close > open

bool reversalSell =
     reversalSellArmed and
     not na(sellBOSLevel) and
     not na(sellBOSBar) and
     bar_index > sellBOSBar and
     high >= sellBOSLevel - retestBuffer and
     close < sellBOSLevel and
     close < open

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// HOURLY BREAKOUTS FOR CONTINUATION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bool bullishBreakout =
     (not na(todayHigh) and h1Close > todayHigh and h1PreviousClose <= todayHigh) or
     (not na(yesterdayHigh) and h1Close > yesterdayHigh and h1PreviousClose <= yesterdayHigh) or
     (not na(twoDaysHigh) and h1Close > twoDaysHigh and h1PreviousClose <= twoDaysHigh) or
     (not na(todayLow) and h1Close > todayLow and h1PreviousClose <= todayLow) or
     (not na(yesterdayLow) and h1Close > yesterdayLow and h1PreviousClose <= yesterdayLow) or
     (not na(twoDaysLow) and h1Close > twoDaysLow and h1PreviousClose <= twoDaysLow)

bool bearishBreakout =
     (not na(todayLow) and h1Close < todayLow and h1PreviousClose >= todayLow) or
     (not na(yesterdayLow) and h1Close < yesterdayLow and h1PreviousClose >= yesterdayLow) or
     (not na(twoDaysLow) and h1Close < twoDaysLow and h1PreviousClose >= twoDaysLow) or
     (not na(todayHigh) and h1Close < todayHigh and h1PreviousClose >= todayHigh) or
     (not na(yesterdayHigh) and h1Close < yesterdayHigh and h1PreviousClose >= yesterdayHigh) or
     (not na(twoDaysHigh) and h1Close < twoDaysHigh and h1PreviousClose >= twoDaysHigh)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CONTINUATION SETUPS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var int continuationDirection = 0
var float continuationHigh = na
var float continuationLow = na
var float continuationFib = na
var bool continuationTouched = false

if newH1Bar and bullishBreakout
    continuationDirection := 1
    continuationHigh := h1High
    continuationLow := not na(lastPivotLow) ? lastPivotLow : h1Low
    continuationFib := na
    continuationTouched := false

if newH1Bar and bearishBreakout
    continuationDirection := -1
    continuationLow := h1Low
    continuationHigh := not na(lastPivotHigh) ? lastPivotHigh : h1High
    continuationFib := na
    continuationTouched := false

if continuationDirection == 1
    continuationHigh := math.max(nz(continuationHigh, high), high)

    if not na(lastPivotLow) and lastPivotLow < continuationHigh
        continuationLow := lastPivotLow

    float bullRange = continuationHigh - continuationLow

    if bullRange > syminfo.mintick
        continuationFib := continuationHigh - bullRange * fibLevel / 100

if continuationDirection == -1
    continuationLow := math.min(nz(continuationLow, low), low)

    if not na(lastPivotHigh) and lastPivotHigh > continuationLow
        continuationHigh := lastPivotHigh

    float bearRange = continuationHigh - continuationLow

    if bearRange > syminfo.mintick
        continuationFib := continuationLow + bearRange * fibLevel / 100

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CONTINUATION TOUCH AND CONFIRMATION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bool bullFibTouch =
     continuationDirection == 1 and
     not na(continuationFib) and
     low <= continuationFib + continuationBuffer and
     high >= continuationFib - continuationBuffer

bool bearFibTouch =
     continuationDirection == -1 and
     not na(continuationFib) and
     high >= continuationFib - continuationBuffer and
     low <= continuationFib + continuationBuffer

if bullFibTouch
    continuationTouched := true

if bearFibTouch
    continuationTouched := true

bool continuationBuy =
     continuationDirection == 1 and
     continuationTouched and
     not na(continuationFib) and
     close > continuationFib and
     close > open

bool continuationSell =
     continuationDirection == -1 and
     continuationTouched and
     not na(continuationFib) and
     close < continuationFib and
     close < open

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INDEPENDENT BUY / SELL SIGNAL PROTECTION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var float lastBuySignalPrice = na
var int lastBuySignalBar = na
var float lastSellSignalPrice = na
var int lastSellSignalBar = na

bool buyDistanceAllowed = na(lastBuySignalPrice) or math.abs(close - lastBuySignalPrice) >= duplicateDistance
bool buyBarsAllowed = na(lastBuySignalBar) or bar_index - lastBuySignalBar >= duplicateBars

bool sellDistanceAllowed = na(lastSellSignalPrice) or math.abs(close - lastSellSignalPrice) >= duplicateDistance
bool sellBarsAllowed = na(lastSellSignalBar) or bar_index - lastSellSignalBar >= duplicateBars

bool canPrintBuy = buyDistanceAllowed and buyBarsAllowed
bool canPrintSell = sellDistanceAllowed and sellBarsAllowed

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FINAL BUY AND SELL SIGNALS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bool rawBuy = reversalBuy or continuationBuy
bool rawSell = reversalSell or continuationSell

bool buySignal = barstate.isconfirmed and rawBuy and canPrintBuy
bool sellSignal = barstate.isconfirmed and rawSell and canPrintSell

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DIAGNOSTIC MARKERS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

plotshape(showDiagnostics and doubleTopDetected, title="H1 Double Top", style=shape.labeldown, location=location.abovebar, color=color.red, text="DOUBLE TOP", textcolor=color.white, size=size.tiny)

plotshape(showDiagnostics and doubleBottomDetected, title="H1 Double Bottom", style=shape.labelup, location=location.belowbar, color=color.blue, text="DOUBLE BOTTOM", textcolor=color.white, size=size.tiny)

plotshape(showDiagnostics and h1SellConfirmed, title="H1 Sell Rejection Confirmed", style=shape.labeldown, location=location.abovebar, color=color.maroon, text="H1 SELL OK", textcolor=color.white, size=size.tiny)

plotshape(showDiagnostics and h1BuyConfirmed, title="H1 Buy Rejection Confirmed", style=shape.labelup, location=location.belowbar, color=color.navy, text="H1 BUY OK", textcolor=color.white, size=size.tiny)

plotshape(showDiagnostics and barstate.isconfirmed and bullishBOS, title="Bullish M1 BOS", style=shape.triangleup, location=location.belowbar, color=color.aqua, text="BOS", textcolor=color.aqua, size=size.small)

plotshape(showDiagnostics and barstate.isconfirmed and bearishBOS, title="Bearish M1 BOS", style=shape.triangledown, location=location.abovebar, color=color.orange, text="BOS", textcolor=color.orange, size=size.small)

plotshape(showDiagnostics and barstate.isconfirmed and reversalBuy, title="Bullish Retest", style=shape.circle, location=location.belowbar, color=color.lime, text="RETEST", textcolor=color.black, size=size.tiny)

plotshape(showDiagnostics and barstate.isconfirmed and reversalSell, title="Bearish Retest", style=shape.circle, location=location.abovebar, color=color.fuchsia, text="RETEST", textcolor=color.white, size=size.tiny)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BLOCKED SIGNAL DIAGNOSTICS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bool blockedBuy = barstate.isconfirmed and rawBuy and not canPrintBuy
bool blockedSell = barstate.isconfirmed and rawSell and not canPrintSell

bool firstBlockedBuy = blockedBuy and not (rawBuy[1] and not canPrintBuy[1])
bool firstBlockedSell = blockedSell and not (rawSell[1] and not canPrintSell[1])

if showDiagnostics and showBlockedLabels and firstBlockedBuy
    label.new(bar_index, low, "BLOCKED BUY\nDistance: " + str.tostring(buyDistanceAllowed) + "\nBars: " + str.tostring(buyBarsAllowed), style=label.style_label_up, color=color.orange, textcolor=color.black, size=size.small)

if showDiagnostics and showBlockedLabels and firstBlockedSell
    label.new(bar_index, high, "BLOCKED SELL\nDistance: " + str.tostring(sellDistanceAllowed) + "\nBars: " + str.tostring(sellBarsAllowed), style=label.style_label_down, color=color.orange, textcolor=color.black, size=size.small)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BUY SIGNAL
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if buySignal
    label.new(bar_index, low, "BUY", style=label.style_label_up, color=color.blue, textcolor=color.white, size=size.small)

    lastBuySignalPrice := close
    lastBuySignalBar := bar_index

    reversalBuyArmed := false
    buyBOSLevel := na
    buyBOSBar := na

    if continuationDirection == 1
        continuationDirection := 0
        continuationTouched := false

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SELL SIGNAL
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if sellSignal
    label.new(bar_index, high, "SELL", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

    lastSellSignalPrice := close
    lastSellSignalBar := bar_index

    reversalSellArmed := false
    sellBOSLevel := na
    sellBOSBar := na

    if continuationDirection == -1
        continuationDirection := 0
        continuationTouched := false

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ALERTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

alertcondition(buySignal, title="BREAKOUTBULL BUY", message="BREAKOUTBULL SYSTEM V3: BUY signal on {{ticker}} at {{close}}")
alertcondition(sellSignal, title="BREAKOUTBULL SELL", message="BREAKOUTBULL SYSTEM V3: SELL signal on {{ticker}} at {{close}}")